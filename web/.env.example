# Required — Payload signs tokens with this. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Required — Postgres connection string (Neon, Vercel Postgres, or local).
# Use the pooled URL on serverless hosts.
# Aliases also accepted: DATABASE_URL (Neon) or POSTGRES_URL (Vercel Postgres).
DATABASE_URI=postgres://postgres@127.0.0.1:5432/zrteam

# Public site URL for canonical tags, sitemap and hreflang.
# On Vercel Preview this can be omitted — https://$VERCEL_URL is used.
# Set it in Production to the live domain, e.g. https://zrteam.sk
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional locally; required on Vercel. Auto-set if you attach a Vercel Blob store.
# Without it, uploads go to ./public/media, which serverless hosts cannot write.
BLOB_READ_WRITE_TOKEN=

# Optional — when set, trial/partner form submissions are emailed via Resend.
# Submissions are stored in Payload either way. EMAIL_FROM must be a verified
# Resend sender (bare address; the display name is hard-coded as "ZR Team").
RESEND_API_KEY=
EMAIL_FROM=noreply@zrteam.sk
EMAIL_TO=info@zrteam.sk

# Optional — create the first /admin user when running `pnpm seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
