# Required — Payload signs tokens with this. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Required — Postgres connection string (Neon / Vercel Postgres / local).
# Use the pooled connection string on serverless hosts.
DATABASE_URI=postgres://postgres@127.0.0.1:5432/zrteam

# Public site URL, used for canonical URLs, sitemap and hreflang tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional — when set, uploads go to Vercel Blob instead of ./public/media.
# Required for any serverless deployment (Vercel has no writable disk).
BLOB_READ_WRITE_TOKEN=

# Optional — when set, form submissions are emailed via Resend.
RESEND_API_KEY=
EMAIL_FROM=ZR Team <noreply@zrteam.sk>
EMAIL_TO=info@zrteam.sk
