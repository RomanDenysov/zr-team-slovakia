---
interface Props {
	class?: string;
	width?: number;
	height?: number;
	alt?: string;
	decorative?: boolean;
}

const {
	class: className,
	width = 44,
	height = 44,
	alt = 'ZRTeam',
	decorative = false,
} = Astro.props;
---

<img
	src="/zr-logo.svg"
	alt={decorative ? '' : alt}
	class:list={['shrink-0', className]}
	width={width}
	height={height}
	aria-hidden={decorative ? 'true' : undefined}
/>
