---
import { mapInlineImageUrl } from '../../utils/sanity/contentImage';

interface Props {
	node: {
		alt?: string;
		caption?: string;
		asset?: { _ref: string; _type: 'reference' };
		hotspot?: { x: number; y: number; height: number; width: number };
		crop?: { top: number; bottom: number; left: number; right: number };
	};
}

const { node } = Astro.props;
const url = mapInlineImageUrl(node);
const alt = node.alt ?? '';
const caption = node.caption ?? '';
---

{
	url ? (
		<figure class="article-figure">
			<img src={url} alt={alt} class="w-full rounded-lg" loading="lazy" decoding="async" />
			{caption ? <figcaption class="article-caption">{caption}</figcaption> : null}
		</figure>
	) : null
}
