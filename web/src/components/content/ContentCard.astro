---
interface Props {
	href: string;
	kicker: string;
	title: string;
	excerpt?: string;
	tag?: string;
	meta?: string;
	imageUrl?: string | null;
	imageAlt?: string;
}

const { href, kicker, title, excerpt, tag, meta, imageUrl, imageAlt = '' } = Astro.props;
---

<a
	href={href}
	class="group overflow-hidden rounded-lg border border-white/7 bg-zr-bg-card transition-colors hover:border-zr-green/40"
>
	<div class="relative h-[130px] overflow-hidden bg-zr-bg-surface">
		{
			imageUrl ? (
				<img
					src={imageUrl}
					alt={imageAlt}
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="ph flex h-full items-end p-3.5">
					<span class="font-mono text-[11px] text-[#5a6a5d]">[ photo ]</span>
				</div>
			)
		}
		{
			tag ? (
				<span class="absolute top-3 left-3.5 font-condensed rounded bg-zr-green px-2.5 py-1 text-xs font-bold tracking-wide text-zr-bg">
					{tag}
				</span>
			) : null
		}
	</div>
	<div class="p-5">
		<div class="font-condensed text-[13px] font-bold tracking-wide text-zr-green">{kicker}</div>
		<div class="font-display mt-1.5 text-xl leading-tight font-semibold text-white uppercase group-hover:text-zr-green">
			{title}
		</div>
		{
			excerpt ? (
				<p class="mt-3 line-clamp-3 text-[14px] leading-relaxed text-zr-text-secondary">
					{excerpt}
				</p>
			) : null
		}
		{meta ? <div class="mt-3 text-[12.5px] text-zr-text-faint">{meta}</div> : null}
	</div>
</a>
