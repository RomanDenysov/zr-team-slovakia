---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Main from '../../layouts/main.astro';
import Container from '../../components/layout/Container.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import ModalShell from '../../components/modals/ModalShell.astro';
import EventsData from '../../components/events/EventsData.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import { localePathParams } from '../../i18n/locales';
import { resolveLocalePageContext } from '../../i18n/pageContext';
import { translations } from '../../i18n/translations';
import { getPosts } from '../../utils/sanity/posts';

export function getStaticPaths() {
	return localePathParams();
}

const pageContext = resolveLocalePageContext(Astro.params.locale);
if (!pageContext) return Astro.redirect('/');

const { locale, lang } = pageContext;
const t = translations[lang];
const eventsHref = getRelativeLocaleUrl(locale, 'events');
const postsHref = getRelativeLocaleUrl(locale, 'posts');
const posts = (await getPosts(lang)).slice(0, 3);
---

<Main title="O nás — ZR Team" currentPath="about" lang={lang} locale={locale}>
	<Container class="max-w-7xl py-16">
		<div class="max-w-[760px]">
			<div
				class="font-condensed mb-2.5 text-sm font-semibold tracking-[4px] text-zr-green"
			>
				{t.wayKicker}
			</div>
			<h1 class="font-display text-5xl leading-tight font-bold text-white uppercase">
				{t.wayTitle}
			</h1>
			<p class="mt-5 text-[17px] leading-relaxed text-zr-text-secondary">
				{t.wayIntro}
			</p>
		</div>

		<div class="way-grid mt-10 grid grid-cols-2 gap-4" data-way-items></div>

		<section class="mt-14 border-t border-white/7 pt-12">
			<h2
				class="font-display mb-1.5 text-[30px] leading-none font-bold text-white uppercase"
			>
				{t.aboutTitle}
			</h2>
			<p class="mb-6 text-[13px] text-zr-text-faint">{t.aboutClickHint}</p>
			<div class="grid grid-cols-2 gap-4" data-locations data-locations-variant="full"></div>
		</section>

		<section class="mt-14 border-t border-white/7 pt-12">
			<div class="mb-7 flex items-end justify-between">
				<div>
					<div
						class="font-condensed mb-2 text-sm font-semibold tracking-[4px] text-zr-green"
					>
						{t.eventsKicker}
					</div>
					<h2
						class="font-display text-[34px] leading-none font-bold text-white uppercase"
					>
						{t.eventsTitle}
					</h2>
				</div>
				<a
					href={eventsHref}
					data-events-show-more
					class="font-condensed text-sm font-bold tracking-wide text-zr-green uppercase"
				>
					{t.showMore} →
				</a>
			</div>
			<div class="events-preview-grid grid grid-cols-3 gap-4" data-events-preview></div>
		</section>

		<section class="mt-14 border-t border-white/7 pt-12">
			<div class="mb-7 flex items-end justify-between">
				<div>
					<div
						class="font-condensed mb-2 text-sm font-semibold tracking-[4px] text-zr-green"
					>
						{t.postsKicker}
					</div>
					<h2
						class="font-display text-[34px] leading-none font-bold text-white uppercase"
					>
						{t.postsTitle}
					</h2>
				</div>
				<a
					href={postsHref}
					class="font-condensed text-sm font-bold tracking-wide text-zr-green uppercase"
				>
					{t.showAllPosts} →
				</a>
			</div>
			{
				posts.length > 0 ? (
					<div class="grid grid-cols-3 gap-4">
						{posts.map((post) => (
							<ContentCard
								href={getRelativeLocaleUrl(locale, `posts/${post.slug}`)}
								kicker={post.date}
								title={post.title}
								excerpt={post.excerpt}
								imageUrl={post.imageUrl}
								imageAlt={post.imageAlt}
							/>
						))}
					</div>
				) : (
					<p class="text-zr-text-muted">—</p>
				)
			}
		</section>
	</Container>

	<CtaBand lang={lang} />

	<ModalShell slot="modals" />
	<EventsData slot="modals" lang={lang} />
</Main>
