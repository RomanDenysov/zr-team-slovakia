---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Main from '../../../layouts/main.astro';
import Container from '../../../components/layout/Container.astro';
import ArticleContent from '../../../components/content/ArticleContent.astro';
import CoverImage from '../../../components/content/CoverImage.astro';
import { locales, defaultLocale, type Locale } from '../../../i18n/locales';
import { localeToLang } from '../../../i18n/locales';
import { translations } from '../../../i18n/translations';
import { getEvent, getEventSlugs } from '../../../utils/sanity/events';

export async function getStaticPaths() {
	const slugs = await getEventSlugs();

	return locales.flatMap((locale) =>
		slugs.map((slug) => ({
			params: {
				locale: locale === defaultLocale ? undefined : locale,
				slug,
			},
			props: { locale },
		})),
	);
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const lang = localeToLang(locale);
const t = translations[lang];
const event = await getEvent(Astro.params.slug ?? '', lang);
if (!event) return Astro.redirect(getRelativeLocaleUrl(locale, 'events'));

const eventsHref = getRelativeLocaleUrl(locale, 'events');
---

<Main
	title={`${event.title} — ZR Team`}
	description={event.desc}
	currentPath="events"
	lang={lang}
	locale={locale}
>
	<Container class="max-w-3xl py-16">
		<a
			class="font-condensed text-sm font-bold tracking-wide text-zr-green uppercase hover:underline"
			href={eventsHref}
		>
			← {t.eventsTitle}
		</a>
		<article class="mt-8">
			<div class="flex flex-wrap items-center gap-3">
				<span class="font-condensed rounded bg-zr-green px-2.5 py-1 text-xs font-bold tracking-wide text-zr-bg">
					{event.tag}
				</span>
				<span class="font-condensed text-[13px] font-bold tracking-wide text-zr-green">
					{event.date}
				</span>
			</div>
			<h1 class="font-display mt-4 text-4xl leading-tight font-bold text-white uppercase">
				{event.title}
			</h1>
			<div class="mt-3 flex items-center gap-2 text-zr-text-muted">
				<span class="h-1.5 w-1.5 rounded-full bg-zr-green"></span>
				<span class="text-[14px] font-semibold">{event.place}</span>
			</div>
			{
				event.imageUrl ? (
					<CoverImage
						src={event.imageUrl}
						alt={event.imageAlt}
						class="mt-6 aspect-video w-full rounded-lg object-cover"
					/>
				) : null
			}
			<p class="mt-5 text-lg leading-relaxed text-zr-text-secondary">{event.desc}</p>
			{
				event.registrationUrl ? (
					<a
						href={event.registrationUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="font-condensed mt-6 inline-block rounded bg-zr-green px-8 py-3.5 text-[15px] font-bold tracking-wider text-zr-bg uppercase"
					>
						{t.eventRegister}
					</a>
				) : null
			}
			<ArticleContent body={event.body} lang={lang} />
		</article>
	</Container>
</Main>
